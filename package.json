{
  "name": "biotag-react-native",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/start-expo.js",
    "start:tunnel": "EXPO_HOST_MODE=tunnel node scripts/start-expo.js",
    "api:tunnel": "node scripts/api-tunnel.js",
    "android": "node scripts/start-expo.js --android",
    "ios": "node scripts/start-expo.js --ios",
    "web": "node scripts/start-expo.js --web",
    "web:export": "expo export --platform web",
    "api": "node src/server/index.js",
    "db:setup": "node src/server/setup-db.js",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker/docker-compose.yml logs -f postgres",
    "env:check": "node scripts/check-env.js",
    "bootstrap": "node scripts/bootstrap.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.11",
    "@clerk/expo": "^3.2.14",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "expo-module-scripts": "^55.0.2"
  }
}
