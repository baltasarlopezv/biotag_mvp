# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biotag

# Frontend -> API base URL
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
